<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>Animaze.Client</PackageId>
    <Title>Animaze.Client</Title>
    <Description>.NET client for the Animaze API: avatars, scenes, emotes, poses, idle animations, special actions, camera and avatar transforms, behaviour overrides and events. Native AOT compatible, System.Text.Json source-generated.</Description>
    <PackageTags>animaze;facerig;vtuber;avatar;client;websocket</PackageTags>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Animaze.Client.Tests" />
  </ItemGroup>
</Project>
